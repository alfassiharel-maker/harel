# Copy to .env for local development. NEVER commit .env.
# Production values come from the platform secrets manager, not from a file.

# --- Application ---------------------------------------------------------------
APP_ENV=local                      # local | ci | staging | production
APP_DEBUG=true                     # MUST be false outside local
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=debug
LOG_FORMAT=console                 # console locally, json everywhere else

# --- Database -----------------------------------------------------------------
# The application connects as app_rw: no SUPERUSER, no BYPASSRLS. This is what
# makes row-level security meaningful (docs/06 §3).
DATABASE_URL=postgresql+asyncpg://app_rw:changeme@localhost:5432/aisportscoach
# Separate role for migrations, which a developer runs manually.
DATABASE_MIGRATOR_URL=postgresql://app_migrator:changeme@localhost:5432/aisportscoach
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6379/1

# --- Auth ---------------------------------------------------------------------
# ES256 keypair. Generate:
#   openssl ecparam -genkey -name prime256v1 -noout -out jwt-private.pem
#   openssl ec -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
ACCESS_TOKEN_TTL_SECONDS=600        # 10 minutes
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_HASH_ALGORITHM=argon2id

# --- Encryption ---------------------------------------------------------------
# Envelope encryption for provider OAuth tokens, MFA secrets and payout refs.
# Local dev uses a static key; staging and production MUST use a real KMS.
KMS_PROVIDER=local                  # local | aws_kms | gcp_kms | azure_kv
KMS_KEY_ID=local-dev-key-1
KMS_LOCAL_KEY_BASE64=               # 32 random bytes, base64. Local only.

# --- AI -----------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5
AI_CHAT_EFFORT=medium               # low | medium | high | xhigh | max
AI_DEEP_REVIEW_MODEL=claude-opus-5
AI_DEEP_REVIEW_EFFORT=high
AI_MAX_CONTEXT_TOKENS=8000
AI_PROMPT_CACHE_TTL=1h              # 5m | 1h
# Hard ceilings. The quota is the cost control (docs/10 §4).
AI_FREE_MESSAGES_PER_MONTH=5
AI_PREMIUM_MESSAGES_PER_MONTH=100

# --- Garmin -------------------------------------------------------------------
# Confirm the current flow against Garmin's developer documentation before
# implementing: both OAuth 1.0a and OAuth 2.0 PKCE exist in the wild.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_WEBHOOK_SECRET=
GARMIN_API_BASE_URL=https://apis.garmin.com
# Use the recorded-fixture adapter until Developer Program approval lands.
GARMIN_ADAPTER=mock                 # mock | live

# --- Payments -----------------------------------------------------------------
# Receipts are validated server-side. A client claim of Premium is never trusted.
APPLE_IAP_SHARED_SECRET=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_PLAY_PACKAGE_NAME=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox                  # sandbox | live

# --- Notifications ------------------------------------------------------------
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=

# --- Object storage -----------------------------------------------------------
STORAGE_PROVIDER=local              # local | s3 | gcs | azure
STORAGE_BUCKET=aisportscoach-streams
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aisportscoach-api

# --- Feature flags ------------------------------------------------------------
FEATURE_REWARDS_ENABLED=false        # Phase 4
FEATURE_PAYOUTS_ENABLED=false        # Phase 4 — requires legal sign-off
FEATURE_COMMUNITY_ENABLED=false      # Phase 4
FEATURE_COACH_PORTAL_ENABLED=false   # Phase 5
